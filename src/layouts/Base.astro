---
// Shared page shell. Markdown pages in src/pages/ can use it via `layout: ../layouts/Base.astro`.
import "../styles/global.css";
import { site } from "../data/site";

const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
    <footer>© {new Date().getFullYear()} {site.name}</footer>
  </body>
</html>
